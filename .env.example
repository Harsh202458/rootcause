# RootCause settings for code that runs on your machine (agent, fault injector,
# eval runner, dashboard). The containers get their settings from
# infra/docker-compose.yml.

# LLM providers. Only the one you use needs a key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# GROQ_API_KEY=
# GROQ_MODEL=
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=

# Agent limits
AGENT_MAX_STEPS=15
AGENT_TOKEN_BUDGET=100000
AGENT_TIMEOUT_MS=300000
# Reuse identical LLM responses during development. Evals always bypass it.
RESPONSE_CACHE_ENABLED=false

# Connections from your machine into the containers
PROMETHEUS_URL=http://localhost:9090
OPS_DB_URL=postgres://rootcause:rootcause_password@localhost:5432/ops
ADMIN_DB_URL=postgres://rootcause:rootcause_password@localhost:5432/rootcause
AGENT_READONLY_DB_BASE=postgres://agent_readonly:agent_readonly@localhost:5432
