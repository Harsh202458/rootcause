# RootCause Environment Variables

# Service ports
GATEWAY_PORT=3000
ORDERS_PORT=3001
INVENTORY_PORT=3002
PAYMENTS_PORT=3003

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=rootcause
POSTGRES_PASSWORD=rootcause_password
POSTGRES_DB=rootcause
OPS_DB=ops

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Service URLs (used by gateway)
ORDERS_URL=http://orders:3001
INVENTORY_URL=http://inventory:3002
PAYMENTS_URL=http://payments:3003

# Database pool
DB_POOL_MIN=2
DB_POOL_MAX=10

# Service version
SERVICE_VERSION=1.4.0

# Observability
LOKI_URL=http://loki:3100
PROMETHEUS_URL=http://prometheus:9090

# LLM Providers (Phase 5+)
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-70b-versatile
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# Agent settings
AGENT_MAX_STEPS=15
AGENT_TOKEN_BUDGET=100000
AGENT_TIMEOUT_MS=300000
RESPONSE_CACHE_ENABLED=true

# Load generator
LOAD_RPS=20
LOAD_TARGET_URL=http://localhost:3000

# Host-side connections used by the agent, fault injector and eval runner
OPS_DB_URL=postgres://rootcause:rootcause_password@localhost:5432/ops
ADMIN_DB_URL=postgres://rootcause:rootcause_password@localhost:5432/rootcause
AGENT_READONLY_DB_BASE=postgres://agent_readonly:agent_readonly@localhost:5432
